{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "doc-page.js",
              "ui_kits/lens-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|JetBrains Mono|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Outfit, JetBrains Mono, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:count|premium|outline|solid)$/]",
        "message": "<Badge> variant must be one of 'count' | 'premium' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|premium|success|warning|accent|neutral)$/]",
        "message": "<Badge> tone must be one of 'primary' | 'premium' | 'success' | 'warning' | 'accent' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: key, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|leadingIcon|trailingIcon|disabled|full|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, leadingIcon, trailingIcon, disabled, full, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|interactive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, interactive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAB'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|shape|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FAB> doesn't accept that prop. Declared props: icon, shape, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAB'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rounded|circle)$/]",
        "message": "<FAB> shape must be one of 'rounded' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|currency|state|statusLabel|meta|estimate|style|key|ref|className|style|children)$/]",
        "message": "<HeroCard> doesn't accept that prop. Declared props: label, amount, currency, state, statusLabel, meta, estimate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ontrack|behind|over)$/]",
        "message": "<HeroCard> state must be one of 'ontrack' | 'behind' | 'over'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|fill|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, fill, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|leadingIcon|type|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, leadingIcon, type, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|light|dark)$/]",
        "message": "<Logo> tone must be one of 'auto' | 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|currency|size|tone|signed|style|key|ref|className|style|children)$/]",
        "message": "<MoneyText> doesn't accept that prop. Declared props: amount, currency, size, tone, signed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|lg|md|sm)$/]",
        "message": "<MoneyText> size must be one of 'hero' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|secondary|income|negative|behind|hero|inherit)$/]",
        "message": "<MoneyText> tone must be one of 'auto' | 'secondary' | 'income' | 'negative' | 'behind' | 'hero' | 'inherit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|track|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, height, track, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|accent|warning)$/]",
        "message": "<ProgressBar> tone must be one of 'primary' | 'success' | 'accent' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|currency|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, amount, currency, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|income|negative|secondary)$/]",
        "message": "<StatCard> tone must be one of 'auto' | 'income' | 'negative' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: label, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|accent|primary|neutral)$/]",
        "message": "<StatusPill> tone must be one of 'success' | 'warning' | 'accent' | 'primary' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|category|amount|currency|kind|date|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TransactionItem> doesn't accept that prop. Declared props: icon, name, category, amount, currency, kind, date, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:expense|income)$/]",
        "message": "<TransactionItem> kind must be one of 'expense' | 'income'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WinCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tint|headline|body|dots|style|key|ref|className|style|children)$/]",
        "message": "<WinCard> doesn't accept that prop. Declared props: icon, tint, headline, body, dots, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WinCard'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:amber|blue|green)$/]",
        "message": "<WinCard> tint must be one of 'amber' | 'blue' | 'green'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
